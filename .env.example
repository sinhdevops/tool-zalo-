# Local overrides. Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN automatically.
ACCOUNT_API_PORT=3001
ACCOUNT_DATA_DIR=.data

# Required on Railway. Use a unique password and a random secret of at least 32 characters.
APP_ADMIN_PASSWORD=replace-with-a-long-password
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Set this to the final Vercel URL, without a trailing slash.
APP_ALLOWED_ORIGINS=https://your-project.vercel.app
